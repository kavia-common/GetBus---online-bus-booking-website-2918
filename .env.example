# Environment example for GetBus PHP app
# Copy this file to ".env" and adjust values for your environment.
# The application reads these using getenv()/$_ENV in config.php.

# Database host (hostname or IP)
DB_HOST=127.0.0.1

# Database port (MySQL default is 3306)
DB_PORT=3306

# Database name that contains the application schema
DB_NAME=online_bus

# Database user with access to the DB_NAME
DB_USER=root

# Database user's password
DB_PASSWORD=

# Notes:
# - In production, set strong DB_USER/DB_PASSWORD and restrict privileges.
# - Ensure the database and tables match the provided SQL dump in db/online_bus (1).sql
# - PHP must be configured to have access to environment variables or load them via your server (Apache/Nginx/FPM).
